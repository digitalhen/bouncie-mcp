{
  "name": "bouncie-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for Bouncie OBD2 GPS vehicle tracking — real-time location, trip history, diagnostics, and fuel data for Claude and AI assistants",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bouncie-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/http.js",
    "start:stdio": "node dist/index.js",
    "dev": "tsx src/http.ts",
    "dev:stdio": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "bouncie",
    "mcp",
    "model-context-protocol",
    "vehicle",
    "obd2",
    "gps",
    "tracking",
    "car",
    "diagnostics",
    "claude",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
