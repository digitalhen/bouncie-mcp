BOUNCIE_CLIENT_ID=your-client-id
BOUNCIE_CLIENT_SECRET=your-client-secret
BOUNCIE_REDIRECT_URI=https://example.com/callback
BOUNCIE_ACCESS_TOKEN=your-access-token
# Or use auth code instead:
# BOUNCIE_AUTH_CODE=your-auth-code

# OAuth for Claude.ai (required for HTTP mode)
PUBLIC_URL=https://bouncie.yourdomain.com
OAUTH_PASSWORD=your-password-here
TOKEN_TTL_HOURS=24
